% PHASENNUMMERIERUNG: Eigener Zaehler fuer automatisch nummerierte Phasen in Tabellen.
% Beispiel: Vor der Tabelle \ResetPhaseCounter, in jeder Datenzeile in Spalte 1: \phasennr
\newcounter{phase}

% PHASENNUMMER: Erhoeht den Phasenzaehler und gibt die aktuelle Nummer fett aus.
% Beispiel: \phasennr & \texttt{Bestandsaufnahme} & \textsf{...} \\
\newcommand{\phasennr}{\stepcounter{phase}\textbf{\thephase}}

% PHASENZAEHLER ZURUECKSETZEN: Setzt die automatische Phasennummerierung wieder auf 0.
% Beispiel: \ResetPhaseCounter
\newcommand{\ResetPhaseCounter}{\setcounter{phase}{0}}

% TABELLENSTIL: Einheitliche Schriftgroesse, Zellabstaende, Linien und Streifen.
% Wird von der Umgebung GPMTable automatisch aktiviert.
\newcommand{\TableSetup}{%
    \scriptsize
    \renewcommand{\arraystretch}{1.25}%
    \setlength{\tabcolsep}{4pt}%
    \setlength{\arrayrulewidth}{0.5pt}%
}

% TABELLENKOPF: Einheitliche Formatierung einer Spaltenueberschrift.
% Beispiel: \TableHead{Verwendungszweck}
\newcommand{\TableHead}[1]{\textbf{#1}}

% EINHEITLICHE GPM-TABELLE:
% - ist immer exakt \textwidth breit,
% - kann ueber mehrere Seiten laufen,
% - wiederholt die Kopfzeile nach einem Seitenumbruch,
% - setzt Tabellenstil, Beschriftung und Label automatisch.
%
% Argument 1: Spaltenaufteilung, mindestens eine Y-Spalte verwenden
% Argument 2: Tabellenbeschriftung
% Argument 3: Label
% Argument 4: Inhalt der Kopfzeile
%
% Beispiel:
% \begin{GPMTable}
%   {L{3cm}|Y|L{2cm}}
%   {Personalressourcen des Projekts}
%   {tab:personalressourcen}
%   {\TableHead{Person} & \TableHead{Aufgabe} & \TableHead{Aufwand}}
%   Max Mustermann & Planung und Dokumentation & 20 h \\
%   \hline
% \end{GPMTable}
\NewDocumentEnvironment{GPMTable}{m m m m +b}{%
    \begingroup
    \TableSetup
    \begin{xltabular}{\linewidth}{|#1|}
    \hline
    \rowcolor{ModuleTableHeader}
    #4 \\
    \hline
    \endfirsthead

    \hline
    \rowcolor{ModuleTableHeader}
    #4 \\
    \hline
    \endhead

    #5

    \ifstrempty{#2}{}{%
        \caption{#2}%
        \ifstrempty{#3}{}{%
            \label{#3}%
        }%
    }%
    \end{xltabular}
    \endgroup
}{}
