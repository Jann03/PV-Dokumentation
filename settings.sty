% TABELLENSPALTEN: P/L/C/R sind feste p-Spalten; Y/Z sind flexible tabularx-Spalten.
% Beispiel: \begin{tabularx}{\textwidth}{P{3cm}Y} ... \end{tabularx}
\newcolumntype{P}[1]{>{\RaggedRight\arraybackslash}p{#1}}
