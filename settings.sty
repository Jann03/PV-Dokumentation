% ---------------------------------------------------------------------------
% 8) Boxen, Bänder und Strukturbausteine
% ---------------------------------------------------------------------------
% THEMENBALKEN: Erzeugt einen farbigen Balken mit frei waehlbarer Farbe.
% Beispiel: \ThemeBar{ModulePrimaryLight}{Zwischenergebnis}
\newcommand{\ThemeBar}[2]{%
    \noindent
    \colorbox{#1}{%
        \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
            \vspace{0.03cm}\normalsize #2\vspace{0.03cm}%
        }%
    }\par\vspace{0.10cm}%
}
% PRIMAERBALKEN: Themenbalken in der primaeren Sekundaerfarbe.
% Beispiel: \PrimaryBand{Versuchsauswertung}
\newcommand{\PrimaryBand}[1]{\ThemeBar{ModuleSecondary}{#1}}
% SEKUNDAERBALKEN: Themenbalken in heller Primaerfarbe.
% Beispiel: \SecondaryBand{Messaufbau}
\newcommand{\SecondaryBand}[1]{\ThemeBar{ModulePrimaryLight}{#1}}

% INFOBOX-UMGEBUNG: Warm hinterlegte, umbrechbare Box fuer laengere Hinweise.
% Beispiel: \begin{UnifiedInfoBox}Hinweistext\end{UnifiedInfoBox}
\newenvironment{UnifiedInfoBox}{%
    \begin{tcolorbox}[
        enhanced,
        breakable,
        colback=ModuleAccentWarm,
        colframe=black!45,
        boxrule=0.45pt,
        left=3mm,right=3mm,top=2mm,bottom=2mm,
        arc=0pt,
        before skip=4pt,
        after skip=4pt
    ]
}{\end{tcolorbox}}
% SOFTBOX-UMGEBUNG: Dezente weisse, umbrechbare Box fuer Zusatzinformationen.
% Beispiel: \begin{UnifiedSoftBox}Zusatztext\end{UnifiedSoftBox}
\newenvironment{UnifiedSoftBox}{%
    \begin{tcolorbox}[
        enhanced,
        breakable,
        colback=white,
        colframe=black!40,
        boxrule=0.45pt,
        left=3mm,right=3mm,top=2mm,bottom=2mm,
        arc=0pt,
        before skip=4pt,
        after skip=4pt
    ]
}{\end{tcolorbox}}
% FORMELBOX-UMGEBUNG: Dezente Box fuer Formeln und zugehoerige Erlaeuterungen.
% Beispiel: \begin{UnifiedFormulaBox}Formel und Erklaerung\end{UnifiedFormulaBox}
\newenvironment{UnifiedFormulaBox}{%
    \begin{tcolorbox}[
        enhanced,
        breakable,
        colback=ModuleFormulaBackground,
        colframe=black!28,
        boxrule=0.45pt,
        left=3mm,right=3mm,top=2.5mm,bottom=2.5mm,
        arc=0pt,
        before skip=4pt,
        after skip=4pt
    ]
}{\end{tcolorbox}}

% INFOBOX: Kurzform fuer eine UnifiedSoftBox.
% Beispiel: \InfoBox{Dieser Abschnitt beschreibt die Messmethode.}
\newcommand{\InfoBox}[1]{\begin{UnifiedSoftBox}#1\end{UnifiedSoftBox}}
% HINWEISBOX: Warm hinterlegte Box mit vorangestelltem Hinweis-Label.
% Beispiel: \HintBox{Vor dem Kompilieren Biber ausfuehren.}
\newcommand{\HintBox}[1]{\begin{UnifiedInfoBox}\textbf{Hinweis:}~#1\end{UnifiedInfoBox}}
% DEFINITIONSBOX: Kompakte Box fuer Definitionen.
% Beispiel: \DefinitionBox{Eine Sprungantwort beschreibt ...}
\newcommand{\DefinitionBox}[1]{%
    \noindent
    \fcolorbox{black}{ModuleAccentWarm}{%
        \parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
            \small\vspace{0.10cm}#1\vspace{0.08cm}%
        }%
    }\par\vspace{0.08cm}%
}

% ZWISCHENUEBERSCHRIFT: Kleine farbige Abschnittszeile ohne Nummerierung.
% Beispiel: \SectionLine{Messwerte}
\newcommand{\SectionLine}[1]{{\color{ModulePrimary}\bfseries\fontsize{11.5}{14.0}\selectfont #1\par}\vspace{0.22cm}}
% ZWISCHENUEBERSCHRIFT: Kleinere farbige Unterabschnittszeile ohne Nummerierung.
% Beispiel: \SubsectionLine{Messwerte}
\newcommand{\SubsectionLine}[1]{{\color{ModulePrimary}\bfseries\fontsize{10.2}{11.8}\selectfont #1\par}\vspace{0.09cm}}
% ZWISCHENUEBERSCHRIFT: Kleine farbige Unterunterabschnittszeile ohne Nummerierung.
% Beispiel: \SubsubsectionLine{Messwerte}
\newcommand{\SubsubsectionLine}[1]{{\color{ModulePrimary}\bfseries\fontsize{8.2}{9.8}\selectfont #1\par}\vspace{0.20cm}}

% BOXED SECTION: Abschnittsueberschrift als Balken; Sternform ohne Nummer.
% Beispiel: \BoxedSection{Auswertung} bzw. \BoxedSection*{Kurzfassung}
\NewDocumentCommand{\BoxedSection}{s m}{%
    \IfBooleanTF{#1}{%
        \addcontentsline{toc}{section}{#2}%
        \ThemeBar{ModuleSecondary}{#2}%
    }{%
        \refstepcounter{section}%
        \addcontentsline{toc}{section}{\protect\numberline{\thesection}#2}%
        \ThemeBar{ModuleSecondary}{\thesection\quad #2}%
    }%
    \vspace{-0.3em}%
}
% BOXED SUBSECTION: Unterabschnittsueberschrift als Balken; Sternform ohne Nummer.
% Beispiel: \BoxedSubsection{Messwerte}
\NewDocumentCommand{\BoxedSubsection}{s m}{%
    \IfBooleanTF{#1}{%
        \addcontentsline{toc}{subsection}{#2}%
        \ThemeBar{ModuleSecondary}{#2}%
    }{%
        \refstepcounter{subsection}%
        \addcontentsline{toc}{subsection}{\protect\numberline{\thesubsection}#2}%
        \ThemeBar{ModuleSecondary}{\thesubsection\quad #2}%
    }%
    \vspace{-0.3em}%
}
% BOXED SUBSUBSECTION: Unterunterabschnitt als Balken; Sternform ohne Nummer.
% Beispiel: \BoxedSubsubsection{Details}
\NewDocumentCommand{\BoxedSubsubsection}{s m}{%
    \IfBooleanTF{#1}{%
        \addcontentsline{toc}{subsubsection}{#2}%
        \ThemeBar{ModuleSecondary}{#2}%
    }{%
        \refstepcounter{subsubsection}%
        \addcontentsline{toc}{subsubsection}{\protect\numberline{\thesubsubsection}#2}%
        \ThemeBar{ModuleSecondary}{\thesubsubsection\quad #2}%
    }%
    \vspace{-0.3em}%
}
% BOXED PARAGRAPH: Absatzueberschrift als Balken; Sternform ohne Nummer.
% Beispiel: \BoxedParagraph{Hinweise}
\NewDocumentCommand{\BoxedParagraph}{s m}{%
    \IfBooleanTF{#1}{\ThemeBar{ModulePrimaryLight}{#2}}{%
        \refstepcounter{paragraph}%
        \ThemeBar{ModulePrimaryLight}{\theparagraph\quad #2}%
    }%
    \vspace{-0.3em}%
}

% AUFGABENABSCHNITT: Erzeugt eine Aufgabenueberschrift mit fortlaufendem Abschnittszaehler.
% Beispiel: \TaskSection
\newcommand{\TaskSection}{%
    \refstepcounter{section}%
    \subsection*{Aufgabe \thesection}%
    \addcontentsline{toc}{section}{Aufgabe \thesection}%
}
% LOESUNGSBALKEN: Markiert einen Loesungsabschnitt.
% Beispiel: \SolutionBar
\newcommand{\SolutionBar}{\ThemeBar{ModuleSecondary}{Lösung}}
% ANALYSEBALKEN: Markiert einen Analyseabschnitt mit frei waehlbarem Titel.
% Beispiel: \AnalysisBar{Interpretation der Messkurve}
\newcommand{\AnalysisBar}[1]{\ThemeBar{ModulePrimaryLight}{#1}}
% QUELLEN-LISTENPUNKT: Listenpunkt mit sauberem Flattersatz.
% Beispiel: \sourceitem{Datenblatt des Sensors}
\newcommand{\sourceitem}[1]{\item \raggedright #1}
% CO2-KURZBEFEHL: Typografische CO2-Darstellung mit PDF-Lesezeichen-Kompatibilitaet.
% Beispiel: Der \COzwei-Ausstoß wird betrachtet.
\newcommand{\COzwei}{\texorpdfstring{CO$}{CO2}}
% SPRUNGSIGNAL: Zeichnet ein kleines Symbol fuer ein Sprungsignal.
% Beispiel: Eingangssignal \sprungsignal
\newcommand{\sprungsignal}{%
    \raisebox{-0.1ex}{\tikz[scale=0.35]{\draw (-0.8,0) -- (0,0) -- (0,0.8) -- (0.8,0.8);}}%
}
% SKIZZENTABELLE: Tabellenzelle mit optionalem Bild und Beschriftung.
% Beispiel: \sketchcell{aufbau}{Versuchsaufbau}
\newcommand{\sketchcell}[2]{%
    \begin{minipage}[t]{\linewidth}\centering
    \begingroup
    \if\relax\detokenize{#1}\relax
    \vspace*{1.6cm}%
    \else
    \adjustbox{max width=\linewidth, max height=2.0cm}{\includegraphics{#1}}\\[-0.2em]%
    \fi
    \endgroup
    \footnotesize #2
    \end{minipage}%
}

