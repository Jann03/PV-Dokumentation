\newcommand{\MakeDocumentTitle}{%
    \begin{titlepage}
    \thispagestyle{empty}
    \sffamily
    \noindent {\large \ResolvedDocumentShortTitle\par}
    \vspace{0.2em}\hrule height 0.4pt\vspace*{1.1cm}
    \noindent
    \begin{minipage}[t]{0.66\textwidth}
    {\color{ModulePrimary}\bfseries\fontsize{18}{22}\selectfont \DocumentType\par}
    \vspace{0.55cm}
    {\color{ModulePrimary}\bfseries\fontsize{28}{34}\selectfont \DocumentTitle\par}
    \ifdefempty{\DocumentSubtitle}{}{\vspace{0.25cm}{\Large \DocumentSubtitle\par}}
    \end{minipage}\hfill
    \begin{minipage}[t]{0.30\textwidth}
    \raggedleft\vspace{0.15cm}\MaybeLogo
    \end{minipage}\par
    \vspace{0.95cm}
    \ifdefempty{\DocumentUnit}{}{\PrimaryBand{\textbf{Versuch / Einheit:} \DocumentUnit}}
    \ifdefempty{\DocumentTopic}{}{\vspace{0.25cm}\SecondaryBand{\textbf{Thema:} \DocumentTopic}}
    \ifdefempty{\DocumentDescription}{}{\vspace{0.45cm}\begin{UnifiedInfoBox}\DocumentDescription\end{UnifiedInfoBox}}
    \vspace{0.8cm}
    \noindent
    \begin{minipage}[t]{0.53\textwidth}\LabMetadataBlock\end{minipage}\hfill
    \begin{minipage}[t]{0.43\textwidth}\LabParticipantsBlock\end{minipage}
    \vfill
    \color{ModuleSecondary}\rule{\textwidth}{1.2pt}\vspace{0.35cm}
    \noindent\small
    \InstitutionName\ifdefempty{\CourseName}{}{\\\CourseName}\ifdefempty{\DepartmentName}{}{\\\DepartmentName}
    \end{titlepage}
    \clearpage
}

\setkomafont{disposition}{\sffamily\bfseries\color{ModulePrimary}}
\addtokomafont{chapter}{\Huge}
\addtokomafont{section}{\LARGE}
\addtokomafont{subsection}{\Large}
\addtokomafont{subsubsection}{\large}
\renewcommand*{\chapterformat}{\thechapter\enskip}
\makeatletter
\@ifclassloaded{scrreprt}{%
    \RedeclareSectionCommand[beforeskip=-20pt plus -6pt minus -4pt, afterskip=12pt]{chapter}%
}{}
