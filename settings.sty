% 9) Mathematik, Theoreme und Gleichungsverzeichnis
% ---------------------------------------------------------------------------
\makeatletter
\@ifundefined{chapter}{%
    \numberwithin{equation}{section}
    \newtheorem{satz}{Satz}[section]
}{%
    \numberwithin{equation}{chapter}
    \newtheorem{satz}{Satz}[chapter]
}
\makeatother
\newtheorem{lemma}[satz]{Lemma}
\theoremstyle{definition}
\newtheorem{definition}[satz]{Definition}
\theoremstyle{remark}
\newtheorem{bemerkung}[satz]{Bemerkung}

% MATHE-KURZBEFEHLE: Mengen und Operatoren fuer mathematische Texte.
% Beispiel: x\in\R, \Var(X), a\defeq b
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\Var}{\mathrm{Var}}
\newcommand{\Cov}{\mathrm{Cov}}
\newcommand{\defeq}{\mathrel{\stackrel{!}{=}}}

\DeclareNewTOC[
    owner=main,
    type=eqn,
    types=equations,
    name={Gleichung},
    listname={Gleichungsverzeichnis}
]{loe}
% GLEICHUNGSVERZEICHNIS: Gibt das automatisch erzeugte Gleichungsverzeichnis aus.
% Beispiel: \listequations
\newcommand{\listequations}{\listofequations}

\makeatletter
\newcommand{\@eqcaptionShort}{}
\newcommand{\@eqcaptionLong}{}
% GLEICHUNGSBESCHRIFTUNG: Fuegt eine equation in das Gleichungsverzeichnis ein.
% Beispiel: \begin{equation}E=mc^2\eqcaption[Einstein]{Masse-Energie-Aequivalenz}\end{equation}
\NewDocumentCommand{\eqcaption}{O{} m}{%
    \gdef\@eqcaptionShort{#1}%
    \gdef\@eqcaptionLong{#2}%
}
\AtBeginEnvironment{equation}{%
    \gdef\@eqcaptionShort{}%
    \gdef\@eqcaptionLong{}%
}
\AtEndEnvironment{equation}{%
    \begingroup
    \edef\@tmpShort{\@eqcaptionShort}%
    \edef\@tmpLong{\@eqcaptionLong}%
    \ifx\@tmpShort\@empty
    \ifx\@tmpLong\@empty
    \else
    \phantomsection
    \addcontentsline{loe}{eqn}{\protect\numberline{\theequation}\@eqcaptionLong}%
    \fi
    \else
    \phantomsection
    \addcontentsline{loe}{eqn}{\protect\numberline{\theequation}\@eqcaptionShort}%
    \fi
    \endgroup
}
\makeatother

% ---------------------------------------------------------------------------
% 10) Projektmanagement-Geruestbausteine
% ---------------------------------------------------------------------------
% Diese Befehle bilden nur die Struktur der Projektdokumentation ab. Sie
% enthalten bewusst keine fachlichen Projektinhalte.

% Sichtbarer Platzhalter fuer spaetere Diagramme, Matrizen und Ablaufplaene.
% STRUKTUR-PLATZHALTER: Sichtbarer Platzhalter fuer spaetere Grafiken oder Plaene.
% Beispiel: \StructurePlaceholder[60mm]{Risikomatrix}
\NewDocumentCommand{\StructurePlaceholder}{O{45mm} m}{%
    \begin{figure}[H]
    \centering
    \fbox{%
        \begin{minipage}[c][#1][c]{0.90\textwidth}
        \centering\itshape [#2]
        \end{minipage}%
    }
    \caption{#2}
    \end{figure}%
}

% Leere Tabellenzeilen mit definierter Mindesthoehe.
% LEERE TABELLENZEILE: Platzhalterzeile mit definierter Mindesthoehe.
% Beispiel: \BlankTableRow
\newcommand{\BlankTableRow}{\rule{0pt}{3.2em} & & & \\}
% LEERE RISIKOZEILE: Platzhalterzeile fuer Risikotabellen.
% Beispiel: \BlankRiskRow
\newcommand{\BlankRiskRow}{\rule{0pt}{4.8em} & & & & & \\}
% LEERE PHASENZEILE: Platzhalterzeile fuer Phasentabellen.
% Beispiel: \BlankPhaseRow
\newcommand{\BlankPhaseRow}{\rule{0pt}{3.8em} & & & \\}


% Farbiger Balken fuer einen Phasenplan.
% Verwendung: \ProjectPhaseBar[Farbe]{Bezeichnung}{Startspalte}{Endspalte}
% PHASENBALKEN: Erzeugt einen farbigen Balken im Gantt-Diagramm.
% Beispiel: \ProjectPhaseBar[PhaseBuild]{Instandsetzung}{3}{5}
\NewDocumentCommand{\ProjectPhaseBar}{O{ModulePrimary} m m m}{%
    \ganttbar[
        bar/.append style={fill=#1,draw=none},
        bar label node/.append style={fill=#1!22,draw=none}
    ]{#2}{#3}{#4}%
}

% Schluessel fuer individuell ausfuellbare Arbeitspakete.
% Werte mit Kommas immer in geschweifte Klammern setzen.
\pgfkeys{
    /workpackage/.is family,
    /workpackage,
    titel/.store in         = \WPTitel,
    psp/.store in           = \WPPSP,
    teilprojekt/.store in   = \WPTeilprojekt,
    datum/.store in         = \WPDatum,
    verantwortlich/.store in= \WPVerantwortlich,
    start/.store in         = \WPStart,
    ende/.store in          = \WPEnde,
    ziele/.store in         = \WPZiele,
    voraussetzungen/.store in=\WPVoraussetzungen,
    ergebnisse/.store in    = \WPErgebnisse,
    schnittstellen/.store in= \WPSchnittstellen,
    aktivitaeten/.store in  = \WPAktivitaeten,
    aufwand/.store in       = \WPAufwand
}

% Fuehrende und abschliessende Leerzeichen im optionalen Schluesselblock entfernen.
% Dadurch darf der Block uebersichtlich ueber mehrere Zeilen geschrieben werden.
\ExplSyntaxOn
\tl_new:N \l_workpackage_options_tl
\cs_new_protected:Npn \WorkPackageSetOptions #1
    {
    \tl_set:Nn \l_workpackage_options_tl {#1}
    \tl_trim_spaces:N \l_workpackage_options_tl
    \tl_put_left:Nn \l_workpackage_options_tl {/workpackage/.cd,}
    \exp_args:NV \pgfkeys \l_workpackage_options_tl
}
\ExplSyntaxOff

% Formular fuer ein detailliertes Arbeitspaket.
% Verwendung: \WorkPackageForm[titel={...},datum={...},...]{AP1}
% ARBEITSPAKET-FORMULAR: Erzeugt ein ausfuellbares Arbeitspaket aus Schluessel-Wert-Paaren.
% Beispiel: \WorkPackageForm[titel={Planung},datum={12.07.2026}]{AP1}
\NewDocumentCommand{\WorkPackageForm}{O{} m}{%
    \begingroup
    \pgfkeys{
        /workpackage/.cd,
        titel=,
        psp=,
        teilprojekt=,
        datum=,
        verantwortlich=,
        start=,
        ende=,
        ziele=,
        voraussetzungen=,
        ergebnisse=,
        schnittstellen=,
        aktivitaeten=,
        aufwand=
    }%
    \WorkPackageSetOptions{#1}%
    \section{Arbeitspaket #2}
    \small
    \renewcommand{\arraystretch}{1.25}
    \begin{tabularx}{\textwidth}{|P{0.20\textwidth}|Y|P{0.14\textwidth}|P{0.18\textwidth}|}
    \hline
    \multicolumn{4}{|l|}{\bfseries ARBEITSPAKET-BESCHREIBUNG #2} \\
    \hline
    \textbf{AP-Titel:} & \WPTitel & \textbf{PSP-Nr.:} & \WPPSP \\
    \hline
    \textbf{Teilprojekt / TPL:} & \WPTeilprojekt & \textbf{Datum:} & \WPDatum \\
    \hline
    \textbf{Verantwortlich:} & \WPVerantwortlich & \textbf{Start:} & \WPStart \\
    \hline
    \textbf{Ende:} & \multicolumn{3}{l|}{\WPEnde} \\
    \hline
    \end{tabularx}

    \vspace{0.35em}

    \begin{tabularx}{\textwidth}{|Y|Y|}
    \hline
    \textbf{Ziele- / Leistungsbeschreibung:} & \textbf{Voraussetzungen (Input):} \\
    \rule{0pt}{8em}\WPZiele & \rule{0pt}{8em}\WPVoraussetzungen \\
    \hline
    \textbf{Ergebnisse / Ergebniserwartung (SMART+):} & \textbf{Schnittstellen:} \\
    \rule{0pt}{8em}\WPErgebnisse & \rule{0pt}{8em}\WPSchnittstellen \\
    \hline
    \textbf{Aktivitaeten / Termine:} & \textbf{Aufwand (Ressourcen):} \\
    \rule{0pt}{8em}\WPAktivitaeten & \rule{0pt}{8em}\WPAufwand \\
    \hline
    \end{tabularx}
    \endgroup
    \clearpage
}

% MATERIALNUMMERIERUNG: Automatische IDs M01, M02, M03 usw.
% Beispiel: Vor der Tabelle \ResetMaterialCounter, je Datenzeile \MaterialID
\newcounter{materialnummer}

\newcommand{\MaterialID}{%
    \stepcounter{materialnummer}%
    \textbf{M\ifnum\value{materialnummer}<10 0\fi%
    \arabic{materialnummer}}%
}

\newcounter{MeilensteinID}
\newcommand{\MS}{%
    \refstepcounter{MeilensteinID}%
    \textbf{M\arabic{MeilensteinID}}%
}


\newcommand{\ResetMaterialCounter}{%
    \setcounter{materialnummer}{0}%
}

% TEILPROJEKT- UND TEILAUFGABENNUMMERIERUNG
% Erzeugt TP 1, TP 2 sowie TA 1.1, TA 1.2, TA 2.1 usw.

\newcounter{teilprojekt}

% Der Teilaufgabenzähler wird bei jedem neuen Teilprojekt zurückgesetzt.
\newcounter{teilaufgabe}[teilprojekt]

\newcommand{\TeilprojektID}{%
    \stepcounter{teilprojekt}%
    \textbf{TP~\arabic{teilprojekt}}%
}

\newcommand{\TeilaufgabeID}{%
    \stepcounter{teilaufgabe}%
    TA~\arabic{teilprojekt}.\arabic{teilaufgabe}%
}

\newcommand{\ResetTeilstrukturCounter}{%
    \setcounter{teilprojekt}{0}%
    \setcounter{teilaufgabe}{0}%
}

